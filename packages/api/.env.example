# HTTP
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

# Same database the indexer writes to. PostgreSQL is recommended for production.
DATABASE_URL=postgres://postgres:sorex@localhost:5432/sorex
STORAGE_DRIVER=postgres
# DATABASE_URL=sqlite:./data/sorex-read.db
# STORAGE_DRIVER=sqlite

# Optional shared cache
# REDIS_URL=redis://localhost:6379

# Limits and caching
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
MAX_PAGE_SIZE=100
CACHE_TTL_MS=5000
CACHE_MAX_ITEMS=500
QUERY_DEPTH_LIMIT=8
QUERY_COMPLEXITY_LIMIT=300
SUBSCRIPTION_POLL_MS=1000

# Observability / labels
METRICS_ENABLED=true
NETWORK=testnet
LOG_LEVEL=info
LOG_PRETTY=false
